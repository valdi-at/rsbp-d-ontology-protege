    <!-- http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Employee -->

    <owl:Class rdf:about="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Employee">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#worksIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Department"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Intern -->

    <owl:Class rdf:about="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Intern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Employee"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Manager"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Manager -->

    <owl:Class rdf:about="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Manager">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Employee"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#manages"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Employee"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Office -->

    <owl:Class rdf:about="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Office"/>
    


