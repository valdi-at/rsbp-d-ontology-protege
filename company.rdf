    <!-- http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#ProjectMember -->

    <owl:Class rdf:about="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#ProjectMember">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#assignedTo"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/air-es-bepek/ontologies/2026/9/company#Project"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


